# ReSkate Tricks dev rig: only the scripts and reference traces are shared.
/dev/*
!/dev/build.cmd
!/dev/run.ps1
!/dev/pass.ps1
!/dev/jumps.py
!/dev/sheet.py
!/dev/trace-*.csv

# Tricks dev rig output (headless run logs, stills, install backups) stays local.
/dev/shots/
/dev/backup/
/dev/rf*.txt
/dev/last-run.log
/dev/start_resume.cmd
